# Server-only variables. Copy to `.env` (gitignored). Never prefix secrets with VITE_*.
# Paopao assistant (Flask / Vercel function reads these; the browser never sees them)
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.7-flash
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Optional: existing local-recommend AI rewrite
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Qwen: AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Qwen: AI_MODEL=qwen-plus
